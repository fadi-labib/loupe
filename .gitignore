# IDE
.vscode/
.idea/
*.swp

# Loupe runtime (consumers may opt to commit these; not in this repo)
# (none — the loupe development repo doesn't contain a `.loupe/` of its own)

# Tier 1 benchmark orchestrator: per-run output, regenerated on every
# `run-tier1.py` invocation. The scenario fixtures themselves (manifest,
# advisory, expected-threats) are tracked; raw run artefacts are not.
/benchmarks/tier1-mongoose/scenarios/*/actual-runs/
/benchmarks/tier1-mongoose/REPORT.md
# run-tier1.py scaffolds this fresh inside the submodule checkout on
# every run; never meant to be tracked there either.
/benchmarks/tier1-mongoose/mongoose-fork/.loupe/

# OS
.DS_Store
site/

# Local agent / IDE session state (worktrees, plans, settings). Never commit.
.claude/

# Project-local Claude Code memory (read by Claude sessions; untracked by
# choice so per-maintainer notes don't leak into public history).
CLAUDE.md
CLAUDE.local.md

# Private design artefacts kept locally only.
# These were scrubbed from git history; do not re-commit. See docs/contributing.md.
/docs/plans/
/docs/specs/
